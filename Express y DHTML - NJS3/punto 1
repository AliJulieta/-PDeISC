<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>DHTML con Express</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <h1 id="titulo"></h1>
  <img id="imagen" src="" alt="" style="display:none;" />

  <div class="botones">
    <button onclick="agregarH1()">Agregar H1</button>
    <button onclick="cambiarTextoH1()">Cambiar Texto H1</button>
    <button onclick="cambiarColorH1()">Cambiar Color H1</button>
    <button onclick="agregarImagen()">Agregar Imagen</button>
    <button onclick="cambiarImagen()">Cambiar Imagen</button>
    <button onclick="cambiarTamanoImagen()">Cambiar Tamaño Imagen</button>
  </div>

  <script src="/js/script.js"></script>
</body>
</html>
//js
function agregarH1() {
    const h1 = document.getElementById('titulo');
    h1.textContent = 'Hola DOM';
  }
  
  function cambiarTextoH1() {
    const h1 = document.getElementById('titulo');
    if (h1.textContent) {
      h1.textContent = 'Chau DOM';
    }
  }
  
  function cambiarColorH1() {
    const h1 = document.getElementById('titulo');
    h1.style.color = '#' + Math.floor(Math.random()*16777215).toString(16);
  }
  
  function agregarImagen() {
    const img = document.getElementById('imagen');
    img.src = '/images/imagen1.jpg';
    img.style.display = 'block';
    img.style.width = '300px';
  }
  
  function cambiarImagen() {
    const img = document.getElementById('imagen');
    img.src = '/images/imagen2.jpg';
  }
  
  function cambiarTamanoImagen() {
    const img = document.getElementById('imagen');
    img.style.width = Math.floor(Math.random() * 500 + 100) + 'px';
  }
